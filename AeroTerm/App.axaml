<Application xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:chrome="using:Avalonia.Controls.Chrome"
             xmlns:edit="using:AvaloniaEdit"
             xmlns:editing="using:AvaloniaEdit.Editing"
             xmlns:theme="using:AeroTerm.Theme"
             x:Class="AeroTerm.App"
             Name="AeroTerm"
             RequestedThemeVariant="Default">
    <NativeMenu.Menu>
        <NativeMenu>
            <NativeMenuItem Header="New Window"
                            Gesture="⌘+N"
                            Click="OnNewWindowClicked" />
            <NativeMenuItemSeparator />
            <NativeMenuItem Header="Settings..."
                            Gesture="⌘+OemComma"
                            Click="OnSettingsClicked" />
        </NativeMenu>
    </NativeMenu.Menu>
    <Application.Resources>
        <!-- Suppress default WindowDrawnDecorations overlay -->
        <ControlTheme x:Key="{x:Type chrome:WindowDrawnDecorations}"
                       TargetType="chrome:WindowDrawnDecorations">
            <Setter Property="DefaultTitleBarHeight" Value="0" />
            <Setter Property="DefaultFrameThickness" Value="0" />
            <Setter Property="DefaultShadowThickness" Value="0" />
            <Setter Property="Template">
                <WindowDrawnDecorationsTemplate>
                    <WindowDrawnDecorationsContent />
                </WindowDrawnDecorationsTemplate>
            </Setter>
        </ControlTheme>
        <ControlTheme x:Key="{x:Type edit:TextEditor}"
                      TargetType="edit:TextEditor">
            <Setter Property="Template">
                <ControlTemplate>
                    <Border Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}">
                        <ScrollViewer Name="PART_ScrollViewer"
                                      Focusable="False"
                                      HorizontalContentAlignment="Left"
                                      HorizontalScrollBarVisibility="{TemplateBinding HorizontalScrollBarVisibility}"
                                      Padding="{TemplateBinding Padding}"
                                      VerticalContentAlignment="Top"
                                      VerticalScrollBarVisibility="{TemplateBinding VerticalScrollBarVisibility}" />
                    </Border>
                </ControlTemplate>
            </Setter>
        </ControlTheme>
        <ControlTheme x:Key="{x:Type editing:TextArea}"
                      TargetType="editing:TextArea">
            <Setter Property="SelectionBrush" Value="{DynamicResource SelectionFillBrush}" />
            <Setter Property="SelectionForeground" Value="{DynamicResource SelectionForegroundBrush}" />
            <Setter Property="Template">
                <ControlTemplate>
                    <DockPanel Background="{TemplateBinding Background}"
                               Focusable="False">
                        <ItemsControl DockPanel.Dock="Left"
                                      Focusable="False"
                                      ItemsSource="{TemplateBinding LeftMargins}">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <StackPanel Orientation="Horizontal" />
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                        </ItemsControl>
                        <Panel>
                            <ContentPresenter Name="PART_CP"
                                              Background="{TemplateBinding Background}"
                                              Cursor="IBeam"
                                              Focusable="False" />
                        </Panel>
                    </DockPanel>
                </ControlTemplate>
            </Setter>
        </ControlTheme>
    </Application.Resources>
    <Application.Styles>
        <theme:AeroTermTheme />
    </Application.Styles>
</Application>
