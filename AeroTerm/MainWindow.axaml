<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:strings="using:AeroTerm.Resources"
        x:Class="AeroTerm.MainWindow"
        Title="{x:Static strings:Strings.AppTitle}"
        RequestedThemeVariant="Default"
        TransparencyLevelHint="None"
        Background="Transparent"
        TransparencyBackgroundFallback="Transparent"
        ExtendClientAreaToDecorationsHint="True"
        ExtendClientAreaTitleBarHeightHint="38"
        WindowDecorations="Full">

    <Window.Styles>
        <Style Selector="Button.titlebar-btn">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Foreground" Value="{DynamicResource TitleBarForegroundBrush}" />
            <Setter Property="BorderThickness" Value="0" />
        </Style>
        <!--
            Hover / pressed Background is set on the templated ContentPresenter
            so it overrides the default Button ControlTheme, which uses the
            same selector specificity (^:pointerover /template/ ContentPresenter)
            with ControlFillHoverBrush. Setting Background on the Button itself
            would lose to the theme setter.
        -->
        <Style Selector="Button.titlebar-btn:pointerover /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource TitleBarButtonHoverBrush}" />
            <Setter Property="BorderBrush" Value="Transparent" />
        </Style>
        <Style Selector="Button.titlebar-btn:pressed /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource TitleBarButtonPressedBrush}" />
            <Setter Property="BorderBrush" Value="Transparent" />
        </Style>
        <Style Selector="Button.titlebar-close:pointerover /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource TitleBarCloseHoverBrush}" />
            <Setter Property="BorderBrush" Value="Transparent" />
            <Setter Property="TextElement.Foreground" Value="White" />
        </Style>
        <Style Selector="Button.titlebar-close:pressed /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource TitleBarClosePressedBrush}" />
            <Setter Property="BorderBrush" Value="Transparent" />
            <Setter Property="TextElement.Foreground" Value="White" />
        </Style>
    </Window.Styles>

    <!--
        Custom Window template that replaces the default.
        Sets Antialias on the root Panel directly, giving the titlebar
        grayscale antialiasing. The terminal content is unaffected because
        TerminalControl uses ICustomDrawOperation with its own SkiaSharp paints.
    -->
    <Window.Template>
        <ControlTemplate TargetType="Window">
            <Panel TextOptions.TextRenderingMode="Antialias">
                <Border Name="PART_TransparencyFallback"
                        IsHitTestVisible="False" />
                <Border Background="{TemplateBinding Background}"
                        IsHitTestVisible="False" />
                <Panel Margin="{TemplateBinding WindowDecorationMargin}"
                       Background="Transparent" />
                <VisualLayerManager>
                    <ContentPresenter Name="PART_ContentPresenter"
                                      Margin="{TemplateBinding Padding}"
                                      HorizontalContentAlignment="{TemplateBinding HorizontalContentAlignment}"
                                      VerticalContentAlignment="{TemplateBinding VerticalContentAlignment}"
                                      Content="{TemplateBinding Content}"
                                      ContentTemplate="{TemplateBinding ContentTemplate}" />
                </VisualLayerManager>
            </Panel>
        </ControlTemplate>
    </Window.Template>

    <Panel>
        <!--
            Content area is first so it renders below the title bar in the
            Z-order, enabling the acrylic blur on the title bar to "dig"
            through to the terminal background.
        -->
        <DockPanel Name="ContentDock" LastChildFill="True">
            <!-- Vertical rail. Its title bar is confined to the rail so the
                 terminal can occupy the full height of the right-hand area. -->
            <Grid Name="SideRail" DockPanel.Dock="Left"
                  Background="Transparent" IsVisible="False">
                <Grid.RowDefinitions>
                    <RowDefinition Height="38" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <Grid Name="VerticalTitleBar" Grid.Row="0"
                      Background="Transparent" IsHitTestVisible="True">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <Border Grid.Column="0" Name="VerticalMacChromeHost"
                            Background="Transparent" />
                    <Border Grid.Column="1" Name="VerticalTitleBarDragHandle"
                            Background="Transparent" Focusable="False" />
                    <Border Grid.Column="2" Name="VerticalWindowControlsHost"
                            Background="Transparent" />
                </Grid>

                <Border Grid.Row="1" Name="SideTabHost"
                        Background="Transparent" />
            </Grid>
            <Border Name="TerminalBorder" Background="Transparent" />
        </DockPanel>

        <!-- Horizontal-mode title bar — floats on top of the content area. -->
        <Grid Name="TitleBar" VerticalAlignment="Top" IsHitTestVisible="True">
            <Grid.ColumnDefinitions>
                <!-- Reservation for the macOS native traffic-light cluster.
                     Width is set to ~78px in code-behind on macOS so the
                     trailing tab strip / title text never sits under the
                     close / minimize / zoom buttons. Zero-width on every
                     other platform and in macOS fullscreen mode. -->
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <!-- macOS traffic-light reservation (see column comment).
                 Hit-test enabled on macOS in code-behind so the empty
                 background area surrounding the native traffic lights
                 still drags / maximizes the window — the AppKit-drawn
                 buttons themselves intercept clicks before Avalonia. -->
            <Border Grid.Column="0" Name="HorizontalMacChromeHost"
                    Background="Transparent">
                <Border Name="MacChromeReservation"
                        Width="0" Background="Transparent"
                        IsHitTestVisible="False" />
            </Border>

            <!-- Logo -->
            <Border Grid.Column="1" Name="LogoDragHandle"
                    Background="Transparent"
                    HorizontalAlignment="Stretch"
                    VerticalAlignment="Stretch"
                    Padding="12,0,8,0">
                <TextBlock Name="LogoText"
                           Text="AeroTerm" VerticalAlignment="Center"
                           Foreground="{DynamicResource TitleBarForegroundBrush}"
                           FontSize="12" FontWeight="Bold" />
            </Border>

            <!-- Tab strip host (used when TabBarOrientation == Horizontal).
                 Stretches across the titlebar; blank trailing area still
                 bubbles pointer presses up to TitleBar_PointerPressed for
                 window dragging. ClipToBounds keeps any transient overflow
                 (e.g., during a tab insertion measure pass) from painting
                 over the trailing system buttons. -->
            <Border Grid.Column="2" Name="TitleBarTabHost"
                    Background="Transparent"
                    HorizontalAlignment="Stretch"
                    VerticalAlignment="Stretch"
                    ClipToBounds="True" />

            <Border Grid.Column="3" Name="HorizontalWindowControlsHost"
                    Background="Transparent">
                <StackPanel Name="WindowControlsPanel"
                            Orientation="Horizontal"
                            VerticalAlignment="Stretch">
                    <!-- Settings Button -->
                    <Button Name="SettingsButton" Content="⚙"
                            AutomationProperties.Name="Settings"
                            ToolTip.Tip="Settings"
                            Classes="titlebar-btn"
                            Width="46" VerticalAlignment="Stretch" FontSize="14"
                            CornerRadius="0"
                            HorizontalContentAlignment="Center"
                            VerticalContentAlignment="Center"
                            Focusable="False"
                            Click="SettingsButton_Click" />

                    <!-- Minimize Button -->
                    <Button Name="MinimizeButton" Content="&#x1F5D5;"
                            AutomationProperties.Name="Minimize"
                            ToolTip.Tip="Minimize"
                            Classes="titlebar-btn"
                            Width="46" VerticalAlignment="Stretch" FontSize="14"
                            CornerRadius="0"
                            HorizontalContentAlignment="Center"
                            VerticalContentAlignment="Center"
                            Focusable="False"
                            Click="MinimizeButton_Click" />

                    <!-- Maximize Button -->
                    <Button Name="MaximizeButton" Content="&#x1F5D6;"
                            AutomationProperties.Name="Maximize"
                            ToolTip.Tip="Maximize"
                            Classes="titlebar-btn"
                            Width="46" VerticalAlignment="Stretch" FontSize="14"
                            CornerRadius="0"
                            HorizontalContentAlignment="Center"
                            VerticalContentAlignment="Center"
                            Focusable="False"
                            Click="MaximizeButton_Click" />

                    <!-- Close Button -->
                    <Button Name="CloseButton" Content="&#x2715;"
                            AutomationProperties.Name="Close"
                            ToolTip.Tip="Close"
                            Classes="titlebar-btn titlebar-close"
                            Width="46" VerticalAlignment="Stretch" FontSize="14"
                            CornerRadius="0"
                            HorizontalContentAlignment="Center"
                            VerticalContentAlignment="Center"
                            Focusable="False"
                            Click="CloseButton_Click" />
                </StackPanel>
            </Border>
        </Grid>

        <!-- macOS camera-housing filler. Only visible in native full screen
             on a notched display while the "use notch area" setting is off:
             the window always spans the whole screen (the bundle opts out of
             safe-area compatibility mode), so the black band that macOS would
             otherwise draw is reproduced here and the rest of the chrome is
             pushed below it. -->
        <Border Name="NotchBand" VerticalAlignment="Top"
                Height="0" IsVisible="False" IsHitTestVisible="False"
                Background="Black" />
    </Panel>
</Window>
