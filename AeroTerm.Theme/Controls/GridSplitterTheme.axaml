<Styles xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <Styles.Resources>
    <ResourceDictionary>
      <!--
        GridSplitter renders as an invisible grab band by default so it does
        not draw a line through composed layouts (split terminal panes, the
        vertical tab rail). The template root still paints a Transparent
        background, which is what makes the splitter hit-testable at all — a
        GridSplitter with no template receives no pointer input and cannot be
        dragged.
      -->
      <ControlTheme x:Key="{x:Type GridSplitter}" TargetType="GridSplitter">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="MinWidth" Value="0" />
        <Setter Property="MinHeight" Value="0" />
        <Setter Property="HorizontalAlignment" Value="Stretch" />
        <Setter Property="VerticalAlignment" Value="Stretch" />
        <Setter Property="Template">
          <ControlTemplate>
            <Border Name="PART_Root"
                    Background="{TemplateBinding Background}"
                    HorizontalAlignment="Stretch"
                    VerticalAlignment="Stretch" />
          </ControlTemplate>
        </Setter>
      </ControlTheme>
    </ResourceDictionary>
  </Styles.Resources>

  <!-- Subtle accent while the pointer is over or actively dragging the band. -->
  <Style Selector="GridSplitter:pointerover /template/ Border#PART_Root">
    <Setter Property="Background" Value="{DynamicResource ControlFillHoverBrush}" />
  </Style>
  <Style Selector="GridSplitter:pressed /template/ Border#PART_Root">
    <Setter Property="Background" Value="{DynamicResource ControlFillPressedBrush}" />
  </Style>
</Styles>
